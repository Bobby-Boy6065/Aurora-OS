#!/usr/bin/env python3
"""Aurora V4 full-screen GTK application launcher."""
import subprocess
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk

APPS = [
    ('Web Browser', 'firefox-esr', '🌐'), ('Files', 'thunar', '📁'),
    ('Terminal', 'xfce4-terminal', '⌨'), ('Settings', 'aurora-control-center', '⚙'), ('Appearance', 'aurora-appearance', '🎨'),
    ('Software Store', 'gnome-software', '🛍'), ('Notes', 'mousepad', '📝'),
    ('Calculator', 'galculator', '➗'), ('Photos', 'ristretto', '🖼'),
    ('PDF Reader', 'evince', '📄'), ('System Monitor', 'xfce4-taskmanager', '📊'),
    ('Bluetooth', 'blueman-manager', 'ᛒ'), ('Wi-Fi', 'nm-connection-editor', '⌁'),
]

CSS = b'''window { background: #10172a; } label { color: #edf3ff; } entry { padding: 12px; border-radius: 14px; font-size: 16px; } button { border-radius: 18px; padding: 16px; background: rgba(255,255,255,0.08); color: #edf3ff; border: 1px solid rgba(255,255,255,0.13); } button:hover { background: rgba(104,158,255,0.24); }'''
class Launcher(Gtk.Window):
    def __init__(self):
        super().__init__(title='Aurora Launcher')
        self.set_default_size(950, 680)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_modal(True)
        self.set_type_hint(Gdk.WindowTypeHint.NORMAL)
        self.set_key_press_event(self.on_key) if hasattr(self, 'set_key_press_event') else None
        self.connect('key-press-event', self.on_key)
        provider=Gtk.CssProvider(); provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        outer=Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16); outer.set_border_width(28); self.add(outer)
        head=Gtk.Label(); head.set_markup('<span size="30000" weight="bold">Aurora</span>  <span size="large">Applications</span>'); head.set_xalign(0); outer.pack_start(head,False,False,0)
        self.search=Gtk.SearchEntry(); self.search.set_placeholder_text('Search apps…'); self.search.connect('search-changed',self.filter); outer.pack_start(self.search,False,False,0)
        self.grid=Gtk.FlowBox(); self.grid.set_selection_mode(Gtk.SelectionMode.NONE); self.grid.set_max_children_per_line(5); self.grid.set_min_children_per_line(3); self.grid.set_row_spacing(12); self.grid.set_column_spacing(12
        ); self.grid.set_homogeneous(True); self.grid.set_valign(Gtk.Align.START)
        scroll=Gtk.ScrolledWindow(); scroll.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.AUTOMATIC); scroll.add(self.grid); outer.pack_start(scroll,True,True,0)
        self.buttons=[]
        for name,cmd,emoji in APPS:
            button=Gtk.Button(); box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8); icon=Gtk.Label(label=emoji); icon.set_markup(f'<span size="32000">{emoji}</span>'); label=Gtk.Label(label=name); box.pack_start(icon,False,False,0); box.pack_start(label,False,False,0); button.add(box); button.set_size_request(150,118); button.connect('clicked',lambda _b,c=cmd:self.launch(c)); self.grid.add(button); self.buttons.append((name,button))
        self.show_all()
    def filter(self,*_):
        q=self.search.get_text().casefold()
        for name,b in self.buttons: b.set_visible(q in name.casefold())
    def launch(self,cmd):
        try: subprocess.Popen([cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError: pass
        self.destroy()
    def on_key(self,_w,event):
        if event.keyval in (Gdk.KEY_Escape,): self.destroy()
        return False
Launcher(); Gtk.main()
