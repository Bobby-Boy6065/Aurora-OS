#!/usr/bin/env python3
import subprocess
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk

class Aurora(Gtk.Window):
    def __init__(self):
        super().__init__(title='Aurora Control Center')
        self.set_default_size(560, 420)
        self.set_border_width(18)
        outer=Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(outer)
        title=Gtk.Label()
        title.set_markup('<span size="24000" weight="bold">Aurora</span>  <span size="large">Control Center</span>')
        title.set_xalign(0)
        outer.pack_start(title, False, False, 4)
        subtitle=Gtk.Label(label='Quick access to desktop settings and tools')
        subtitle.set_xalign(0)
        outer.pack_start(subtitle, False, False, 0)
        grid=Gtk.Grid(column_spacing=10,row_spacing=10)
        outer.pack_start(grid,True,True,8)
        items=[('Appearance','xfce4-appearance-settings'),('Display','xfce4-display-settings'),('Keyboard','xfce4-keyboard-settings'),('Mouse & Touch','xfce4-mouse-settings'),('Power','xfce4-power-manager-settings'),('Network','nm-connection-editor'),('Bluetooth','blueman-manager'),('Sound','pavucontrol'),('File Manager','thunar'),('Terminal','xfce4-terminal'),('Software','gnome-software'),('System Monitor','xfce4-taskmanager')]
        for i,(label,cmd) in enumerate(items):
            b=Gtk.Button(label=label); b.set_size_request(145,62)
            b.connect('clicked',lambda _b,c=cmd: subprocess.Popen(c.split(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
            grid.attach(b,i%3,i//3,1,1)
        footer=Gtk.Label(label='Aurora OS • Surface Edition')
        footer.set_xalign(0)
        outer.pack_end(footer,False,False,4)

win=Aurora()
win.connect('destroy',Gtk.main_quit)
win.show_all()
Gtk.main()
