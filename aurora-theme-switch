#!/usr/bin/env bash
# Switch XFCE between Aurora dark and light presets for the current user.
set -euo pipefail
mode="${1:-dark}"	heme=""
case "$mode" in
  dark) theme="Arc-Dark" ;;
  light) theme="Arc" ;;
  *) echo "Usage: aurora-theme-switch [dark|light]" >&2; exit 2 ;;
esac
if ! command -v xfconf-query >/dev/null; then echo "xfconf-query is required (XFCE session)." >&2; exit 1; fi
xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "$theme" 2>/dev/null || xfconf-query -c xsettings -p /Net/ThemeName -t string -s "$theme"
xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s "Papirus" 2>/dev/null || xfconf-query -c xsettings -p /Net/IconThemeName -t string -s "Papirus"
echo "Aurora appearance set to $mode ($theme)."
