#!/usr/bin/env bash
# Touch-oriented XFCE adjustments. Safe to run as a regular desktop user.
set -euo pipefail
mode="${1:-on}"
case "$mode" in
  on) xfconf-query -c xfce4-panel -p /panels/panel-1/autohide -n -t int -s 1 2>/dev/null || true
      xfconf-query -c xfce4-panel -p /panels/panel-1/size -n -t int -s 48 2>/dev/null || true
      echo "Tablet mode enabled: larger panel and auto-hide. Configure onscreen keyboard from Settings." ;;
  off) xfconf-query -c xfce4-panel -p /panels/panel-1/autohide -n -t int -s 0 2>/dev/null || true
      xfconf-query -c xfce4-panel -p /panels/panel-1/size -n -t int -s 32 2>/dev/null || true
      echo "Tablet mode adjustments disabled." ;;
  *) echo "Usage: aurora-tablet-mode [on|off]" >&2; exit 2 ;;
esac
